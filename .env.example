# =================================================================
# EMPLOYEE REFERRAL PORTAL - PRODUCTION / EC2 ENVIRONMENT TEMPLATE
# Copy this file to .env on your server and update the values.
# =================================================================

# Server Application Configuration
PORT=5000
NODE_ENV=production

# Security Secrets (Must be unique & secret in production!)
JWT_SECRET=super_secret_jwt_key_referal_portal_2026
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database & Cache URLs
# For Docker Compose: postgres://referal_user:referal_password@postgres:5432/referal_db
# For Standalone Postgres: postgres://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=postgres://referal_user:referal_password@postgres:5432/referal_db
REDIS_URL=redis://redis:6379

# Real Email Sending (Gmail / SMTP Credentials)
# SMTP_USER: Your registered Gmail address
# SMTP_PASS: 16-character App Password generated from Google Account
SMTP_SERVICE=gmail
SMTP_USER=your.email@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# AI JD & Resume Matching Engine (Optional LLM Endpoint)
OLLAMA_URL=http://ollama:11434
